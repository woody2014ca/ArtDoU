# 复制为 .env.migrate 并填入真实值（勿提交 git）

# Atlas 目标库（必填）
TARGET_MONGODB_URI=mongodb+srv://用户名:密码@artdou.xxxxx.mongodb.net/?retryWrites=true&w=majority

# 方式 A：直连 Railway Mongo（从 Railway → MongoDB → Variables 复制 MONGO_URL）
SOURCE_MONGODB_URI=mongodb://...

# 库名（一般不用改）
MONGODB_DB=artdou

# 方式 B 经 API 导出时用（ArtDoU 须暂时连回 Railway Mongo）
# API_BASE=https://artdou-production.up.railway.app/api
# ADMIN_PASSWORD=ArtDoU2026
